[node name="RichTextLabel" type="RichTextLabel" parent="ContentDivider/ContentMat/Tabs/Hotkeys/ScrollContainer" index="0"]
margin_right = 405.0
margin_bottom = 1335.0
size_flags_horizontal = 3
size_flags_vertical = 3
custom_colors/default_color = Color( 1, 1, 1, 1 )
custom_fonts/normal_font = SubResource( 15 )
bbcode_enabled = true
bbcode_text = "[center][color=yellow]--List of Hotkeys--[/color][/center]

[center][color=aqua]Camera & Navigation[/color]

    Zoom In/Out: :zoom_in:/:zoom_out:

    Zoom In/Out at Cursor: [color=#7dcbff]Ctrl[/color] + [color=#7dcbff]Scrollwheel[/color]

    Pan Camera: [color=#7dcbff]Middle Click[/color] + [color=#7dcbff]Drag[/color]

[center][color=aqua]Selection & Interaction[/color][/center]

    Pick Item: :pick_focused_item:

    Move Object: [color=#7dcbff]Left Click[/color] + [color=#7dcbff]Drag[/color]

    Duplicate and Move Object: [color=#7dcbff]Shift Left Click[/color] + [color=#7dcbff]Drag[/color]

    Disable 8px Snap: :8_pixel_lock: (Hold)

[center][color=aqua]Object & Tile Tools[/color][/center]
	
	Pen Tool: :pen_tool:
	
	Move Tool: :move_tool:
	
    Paint Tool: :paint_tool:

    Toggle Eraser: :toggle_eraser:
	
	Selection Tool: :selection_tool:

    Tile Lock Tool (Objects): :fill_tool:
	Fill Tool (Tiles): :fill_tool:

    Path Tool (Objects): :rect_fill_tool:
	Rectangle Fill Tool (Tiles): :rect_fill_tool:

    Select Last Used Tile: :last_tile:

    Select Last Used Object: :last_object:

    Open Layer Menu: :layer_menu:

    Switch Layers: [color=#7dcbff]Alt[/color] + [color=#7dcbff]Scrollwheel[/color]

    Toggle Grid: :grid_toggle:

[center][color=aqua]Transformations[/color][/center]

    Flip Selected Objects Horizontally: :mirror_h:

    Flip Selected Objects Vertically: :mirror_v:

    Rotate Selected Objects: :rotate_object: (Hold)

    Scale Selected Objects: :scale_object: (Hold)

[center][color=aqua]Hotbar & Menus[/color][/center]

    Hotbar Buttons: [color=#7dcbff]0[/color] - [color=#7dcbff]9[/color]

    Scroll Through Hotbar: [color=#7dcbff]Scrollwheel[/color]

    Change Hotbar Loadout: [color=#7dcbff]F1[/color] - [color=#7dcbff]F4[/color]

    Collapse/Expand Hotbar: :hide_hotbar:

    Open Item Picker: :item_picker:

    Open Palettes: :choose_palette:
	
	Favorite Item: [color=#7dcbff]Hold Click[/color]

[center][color=aqua]General & Actions[/color][/center]

    Playtest: :switch_modes:

    Undo: [color=#7dcbff]Ctrl[/color] + :undo_action:

    Redo: [color=#7dcbff]Ctrl[/color] + :redo_action:

    Save: [color=#7dcbff]Ctrl[/color] + :save_level:

    Copy: [color=#7dcbff]Ctrl[/color] + :copy_selection:

    Cut: [color=#7dcbff]Ctrl[/color] + :cut_selection:

    Paste: [color=#7dcbff]Ctrl[/color] + :paste_clipboard:[/center]"
text = "--List of Hotkeys--

Camera & Navigation

    Zoom In/Out: :zoom_in:/:zoom_out:

    Zoom In/Out at Cursor: Ctrl + Scrollwheel

    Pan Camera: Middle Click + Drag

Selection & Interaction

    Pick Item: :pick_focused_item:

    Move Object: Left Click + Drag

    Duplicate and Move Object: Shift Left Click + Drag

    Disable 8px Snap: :8_pixel_lock: (Hold)

Object & Tile Tools
	
	Pen Tool: :pen_tool:
	
	Move Tool: :move_tool:
	
    Paint Tool: :paint_tool:

    Toggle Eraser: :toggle_eraser:
	
	Selection Tool: :selection_tool:

    Tile Lock Tool (Objects): :fill_tool:
	Fill Tool (Tiles): :fill_tool:

    Path Tool (Objects): :rect_fill_tool:
	Rectangle Fill Tool (Tiles): :rect_fill_tool:

    Select Last Used Tile: :last_tile:

    Select Last Used Object: :last_object:

    Open Layer Menu: :layer_menu:

    Switch Layers: Alt + Scrollwheel

    Toggle Grid: :grid_toggle:

Transformations

    Flip Selected Objects Horizontally: :mirror_h:

    Flip Selected Objects Vertically: :mirror_v:

    Rotate Selected Objects: :rotate_object: (Hold)

    Scale Selected Objects: :scale_object: (Hold)

Hotbar & Menus

    Hotbar Buttons: 0 - 9

    Scroll Through Hotbar: Scrollwheel

    Change Hotbar Loadout: F1 - F4

    Collapse/Expand Hotbar: :hide_hotbar:

    Open Item Picker: :item_picker:

    Open Palettes: :choose_palette:
	
	Favorite Item: Hold Click

General & Actions

    Playtest: :switch_modes:

    Undo: Ctrl + :undo_action:

    Redo: Ctrl + :redo_action:

    Save: Ctrl + :save_level:

    Copy: Ctrl + :copy_selection:

    Cut: Ctrl + :cut_selection:

    Paste: Ctrl + :paste_clipboard:"
fit_content_height = true
scroll_active = false
script = ExtResource( 7 )

