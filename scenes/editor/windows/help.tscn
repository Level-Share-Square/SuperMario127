2, 196619, 3211233, 5, 15, 3211238, 5, 15, 3276768, 5, 13, 3276769, 2, 65543, 3276773, 5, 13, 3276774, 5, 65543, 3342303, 5, 196609, 3342304, 2, 196613, 3342305, 2, 196619, 3342308, 5, 196609, 3342309, 5, 196613, 3342310, 2, 196619, 3735519, 18, 8, 3735520, 18, 10, 3735521, 18, 10, 3735522, 18, 10, 3735523, 18, 10, 3735524, 18, 11, 3801055, 18, 65544, 3801056, 18, 131081, 3801057, 18, 131081, 3801058, 18, 131081, 3801059, 18, 131081, 3801060, 18, 131083, 3866591, 18, 196616, 3866592, 18, 196617, 3866593, 18, 196617, 3866594, 18, 196617, 3866595, 18, 196617, 3866596, 18, 196619, 4653023, 31, 0, 4653024, 33, 0, 4653025, 34, 0, 4653026, 32, 0, 4653028, 12, 0, 4653029, 9, 1, 4653030, 3, 1, 4653031, 15, 2 )

