[sub_resource type="Shader" id=1]
code = "//from https://godotshaders.com/shader/2d-outline-inline/
shader_type canvas_item;

uniform vec4 color : hint_color = vec4(1.0);
uniform float width = 1.0;
uniform int pattern : hint_range(0, 2) = 0; // diamond, circle, square
uniform float min_alpha : hint_range(0, 1) = 0; // min alpha when considering pixel
uniform float blur_level : hint_range(0, 5) = 1;
uniform bool inside = false;
uniform bool add_margins = true; // only useful when inside is false
uniform vec2 texture_offset = vec2(0);

void vertex() {
	if (add_margins) {
		VERTEX += (UV * 2.0 - 1.0);
	}
}

bool hasContraryNeighbour(vec2 uv, vec2 texture_pixel_size, sampler2D texture) {
	// Only check vertical pixels below (x = 0, y < 0)
	for (float j = -ceil(width); j < 0.0; j++) {
		float y = abs(j) > width ? -width : j;
		vec2 xy = uv + texture_pixel_size * vec2(0.0, y); // x = 0.0: vertical only

		if ((xy != clamp(xy, vec2(0.0), vec2(1.0)) || texture(texture, xy).a <= 0.0) == inside) {
			return true;
		}
	}
	return false;
}


vec4 col_lerp(vec4 a, vec4 b, float t) {
return a + (t * (b - a));
}

float antialias(vec2 uv, vec2 texture_pixel_size, sampler2D in_texture) {
	float output = float(0);
	for (int j = 0; j <= 7; j++) {
		vec2 offset = vec2(sin(float(45) * float(j)) * (texture_pixel_size.x * blur_level), cos(float(45) * float(j)) * (texture_pixel_size.y * blur_level));
		if (hasContraryNeighbour(uv + offset, texture_pixel_size, in_texture)) {
			output += float(1);
	}
}
return output / float(8);
}

void fragment() {
	vec2 uv = UV + (texture_offset * TEXTURE_PIXEL_SIZE);
	vec2 texture_pixel_size = vec2(1.0) / (vec2(1.0) / TEXTURE_PIXEL_SIZE + vec2(width * 2.0));
	if (add_margins) {
		uv = (uv - texture_pixel_size * width) * TEXTURE_PIXEL_SIZE / texture_pixel_size;
		
		if (uv != clamp(uv, vec2(0.0), vec2(1.0))) {
			COLOR.a = 0.0;
		} else {
			COLOR = texture(TEXTURE, uv);
		}
		
	} else {
		COLOR = texture(TEXTURE, uv);
	}

	if ((COLOR.a >= min_alpha) == inside && antialias(uv, TEXTURE_PIXEL_SIZE, TEXTURE) > float(0)) {
		COLOR.rgb = inside ? mix(COLOR.rgb, color.rgb, color.a) : color.rgb;
		COLOR.a += (1.0 - COLOR.a) * color.a;
		COLOR.a *= antialias(uv, TEXTURE_PIXEL_SIZE, TEXTURE);
		COLOR = col_lerp(COLOR, texture(TEXTURE, uv), texture(TEXTURE, uv).a);
	}
}"

