[gd_resource type="Shader" format=2]

[resource]
code = "shader_type canvas_item;

uniform vec4 color : hint_color;
uniform sampler2D noise_texture_1;
uniform sampler2D noise_texture_2;
uniform sampler2D noise_texture_3;

uniform vec2 noise_offset_1;
uniform vec2 noise_speed_1;

uniform vec2 noise_offset_2;
uniform vec2 noise_speed_2;

uniform vec2 noise_offset_3;
uniform vec2 noise_speed_3;

uniform vec2 position;
uniform vec2 size;
uniform vec2 offset;

varying vec2 noise_scale_1;
varying vec2 noise_scale_2;
varying vec2 noise_scale_3;


float random (vec2 uv) {
    return fract(sin(dot(uv.xy, vec2(12.9898,78.233))) * 43758.5453123);
}


float sine(vec2 uv_coords, float time, float arg1, float arg2) {
	return sin((uv_coords.x * arg1 * (size.x / 20.0f)) + time * arg2);
}

vec2 get_scale(ivec2 texture_size) {
	return size/vec2(texture_size);
}

vec2 transform_uv(vec2 uv, vec2 pivot, vec2 scale, float angle, vec2 translation) {
	// First we scale...
	uv -= pivot;
	uv *= scale;
	
	// Next we rotate...
	float cosine = cos(angle);
	float sine = sin(angle);
	uv = vec2(
		uv.x * cosine - uv.y * sine,
		uv.x * sine + uv.y * cosine
	);
	
	// Finally we undo the pivot and translate the UV! Simple :D
	uv += pivot + translation;
	return uv;
}

void fragment() {
	vec2 offset_normal = vec2(offset / size);
	
	vec4 base = texture(TEXTURE, UV);
	base *= color;
	base.rgb /= vec3(2);
	
	noise_scale_1 = get_scale(textureSize(noise_texture_1, 0));
	noise_scale_2 = get_scale(textureSize(noise_texture_2, 0));
	noise_scale_3 = get_scale(textureSize(noise_texture_3, 0));
	
	
	//retooled as a distortion map
	vec2 offset_3 = (noise_offset_3/vec2(textureSize(noise_texture_3, 0))) + (noise_speed_3 * TIME);
	vec2 noise_uv_3 = transform_uv(UV, -position / size, noise_scale_3, 0.0, offset_3 + offset_normal);
	vec4 noise_3 = texture(noise_texture_3, noise_uv_3);
	
	vec2 offset_1 = (noise_offset_1/vec2(textureSize(noise_texture_1, 0))) + (noise_speed_1 * TIME);
	vec2 noise_uv_1 = transform_uv(UV, -position / size, noise_scale_1, 0.0, offset_1 + offset_normal);
	vec4 noise_1 = texture(noise_texture_1, noise_uv_1);
	
	vec2 offset_2 = (noise_offset_2/vec2(textureSize(noise_texture_1, 0))) + (noise_speed_2 * TIME) + (noise_3.xy/(16.0 * ((1.0-UV.y)/2.0+.5)));
	vec2 noise_uv_2 = transform_uv(UV, -position / size, noise_scale_2, 0.0, offset_2 + offset_normal);
	vec4 noise_2 = texture(noise_texture_2, noise_uv_2);
	
	vec3 mix1 = noise_1.rgb/vec3(8.5);
	vec3 mix2 = noise_2.rgb/vec3(4.5);
	
//	base.rgb = base.rgb + mix1 + mix2;
	
	vec2 sine_uv = transform_uv(UV, -position / size, vec2(1.0), 0.0, offset_normal);
	
	float s1 = sine(sine_uv, TIME, 1.0f, 1.5f) * sin(TIME*1.5);
	float s2 = sine(sine_uv, TIME+1.5707f, 1.0f, 1.5f) * sin(TIME*1.5+1.5707f);
	float s3 = sine(sine_uv, TIME, 4.0f, 3.0f);
	
	float final_sine = ((s1 * s2 * 2.0f) + (s3/2.0))*1.75;
	float sine_height = (final_sine / 20.0f) + 0.25f;
	
	if (sine_uv.y < sine_height) {
		base.a = 0.0;
	} else {
		float gradient_pos = (((sine_uv.y * 1.0) - (sine_height * 1.0)) * 24.0) / 8.0;
		vec4 gradient_color = texture(noise_texture_1, vec2(1.0-gradient_pos+(noise_3.r/4.0), 0));
		base.rgb = mix(base.rgb, vec3(1.0), gradient_color.rgb) + (mix2.rgb);
		base.a = clamp((1.0-sine_uv.y)*1.75, 0, 1.0)
	}
	
	COLOR = base;
}"
