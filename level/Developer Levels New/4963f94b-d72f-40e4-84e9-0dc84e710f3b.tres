code = "[{[SPastel%20Citadel,SRudy12345mc,S%22Hop%20across%20the%20cloudy%2c%20pastel%20skyline%2c%0aExplore%20the%20floating%20chasms%2c%20drifting%20and%20divine%2c%0aJump%20up%20high%2c%20soar%20in%20the%20sky%2c%20for%20you%20may%20find%2c%0aVibrant%20rainbow%20artifacts%2c%20sprites%20that%20always%20shine.%22%0a-Edgar%20Allan%20Toad,Spcthumb,IK,IA,IA,IkB][[[Sdc89ccaa-6afc-4324-9e4f-7d1ccf7f0ac4,B1,SLavender%20Arches%20Speedrun,SA%20mysterious%20purple%20cloud%20floats%20to%20the%20left%20of%20the%20Citadel.%20The%20button%20on%20top%20opens%20the%20path%20to%20another.%20Zoom%20from%20one%20end%20of%20the%20level%20to%20the%20other%20to%20claim%20your%20prize%21,ID,C[FA.sC,FA.ZC,FB,FB],B1,IA,Sspawn][S751a3330-3fb5-43da-8c0e-60c441949c68,B1,SRed%20Coins%20on%20the%20Big%20Blossom,SIn%20the%20center%20of%20the%20Citadel%20lies%20a%20huge%20blossom%20tree%21%20Collect%20the%20Red%20Coins%20scattered%20across%20it.%20...Do%20trees%20normally%20grow%20clouds%3f,IB,C[FB,FA.R,FA.2C,FB],B1,IA,Sspawn][S13cb2d31-f547-4f91-9bf2-fe3a61224629,B1,SGreenhouse%20Ascent,SOn%20the%20eastern%20side%20of%20the%20Citadel%20lies%20a%20very%20tall%20greenhouse%2c%20keeping%20many%20of%20it%27s%20plants%20in%20good%20health.%20A%20Shine%20Sprite%20waits%20for%20you%20at%20the%20top.,IA,C[FA.OC,FB,FA.O,FB],B1,IA,Sspawn][Sa8df2108-82ea-4cb9-a9ca-cef4d86c91dd,B1,SToll%20Tower,SCollect%20a%20hefty%20sum%20of%20300%20coins%20to%20open%20the%20door%20of%20the%20Golden%20Tower.,IC,C[FB,FA.9C,FA._B,FB],B1,IA,Sspawn][S79fa1fbd-7788-4d7e-a0c1-7869c030e4da,B1,SGhost%20Pepper%20Sprint,SFind%20a%20Launch%20Star%20tucked%20away%20in%20the%20Citadel%20and%20get%20whisked%20away%20to%20a%20hidden%20challenge.%20Dash%20from%20pepper%20to%20pepper%20before%20time%20runs%20out%21,IE,C[FB,FB,FB,FB],B1,IA,Sspawn]][[Saccbc541-af3b-4341-a7a2-5af17ccadbaf,S,C[FB,FB,FA,FB]][S90a7e13a-702e-434a-be9a-3037477c198f,S,C[FB,FB,FA,FB]][Scac6bcc6-9029-4475-b120-6ffa0a4e52a1,S,C[FB,FB,FA,FB]][S82d5dc56-1792-4aa1-b5e0