script = ExtResource( 1 )
code = "[{[SForgo%20Kingdom,SLinktober,SDeep%20within%20the%20woods%2c%20the%20remains%20of%20a%20kingdom%20named%20Forgo%20Kingdom%20may%20be%20found.%20Despite%20it%27s%20alias%2c%20this%20Lost%20Kingdom%27s%20whereabouts%20is%20known%20by%20many%20explorers%20and%20thieves%20alike.%20The%20reason%20for%20the%20name%3f%20Any%20who%20venture%20to%20this%20spot%20are%20never%20to%20be%20seen%20again.%20Will%20you%20be%20the%20exception%3f%20Or%20will%20you%20be%20the%20rule%3f,S,ID,IB,IA,IlB][[[S58bd6a00-7922-420b-9f11-541b2032f4cc,B1,SThe%20Castle,SDeep%20in%20the%20Central%20Castle%2c%20locked%20behind%20metal%20bars%2c%20is%20a%20Shine%20Sprite.%20Though%20small%20in%20size%2c%20this%20fort%20served%20to%20guard%20the%20kingdom%27s%20greatest%20treasures.%20Now%20all%20that%20remains%20is%20this%20single%20Shine%20Sprite.,IC,C[FB,FB,FA,FB],B0,IA,Sspawn,I~B][Se7d8bb13-71ff-46df-a11c-0a929910fcb3,B1,SPlateau%20Ruins,SA%20Rainbow%20Star%20stands%20in%20the%20Eastern%20Plateau%20Ruins.%20A%20great%20bridge%20used%20to%20span%20this%20plateau%2c%20but%20the%20passage%20of%20time%20has%20been%20especially%20unkind%20to%20it.%20Nature%20has%20taken%20it%27s%20hold.,ID,C[FB,FB,FA,FB],B0,IA,Sspawn,I~B][S809ef7e6-c17e-49a3-af1e-6c4304714bc1,B1,SCrypt%20Watchtower,SWestward%20past%20the%20crypts%20lies%20a%20watchtower%2c%20and%20atop%20the%20tower%20a%20Shine%20Sprite.%20It%27s%20said%20that%20on%20the%20night%20of%20a%20full%20moon%2c%20you%20may%20see%20spirits%20wandering%20the%20kingdom%27s%20graves.,IG,C[FB,FB,FA,FB],B0,IA,Sspawn,I~B][S767561f9-c3fe-4559-9240-2bb98d653bc3,B1,SLost%20Red%20Coins,SScattered%20across%20the%20Kingdom%27s%20grounds%20are%20eight%20Red%20Coins.%20None%20will%20be%20found%20in%20the%20kingdom%27s%20skies.%20The%20historybooks%20state%20that%20the%20Red%20Coin%20was%20a%20taboo%20currency%20among%20residents%2c%20It%27s%20hue%20reminding%20folk%20of%20blood.,II,C[FB,FB,FA,FB],B1,IA,Sspawn,I~B][Sebca6b6e-d0b7-4a8d-966c-d094fed5160e,B1,SThe%20Sky-Piercing%20Spire,SClimb%20the%20central%20spire%20of%20Forgo%20Kingdom.%20Despite%20it%27s%20imposing%20size%2c%20it%20was%20seen%20merely%20a%20vantage%20point%20for%20viewing%20other%20apsects%20of%20the%20Kingdom.,IF,C[FB,FB,FA,FB],B0,IA,Sspawn,I~B][S84e1c4cc-d5eb-4b31-a00d-fb651136ccf7,B1,SKingdom%20in%20the%20Sky,SIn%20structures%20scattered%20across%20the%20skies%20lie%20Shine%20Shards.%20The%20Kingdom%20never%20used%20to%20be%20shattered%20like%20this.%20Nobody%20has%20a%20clue%20what%20may%20have%20caused%20the%20collapse%20of%20Forgo%20Kingdom%20to%20happen%2c%20but%20it%27s%20theorized%20that%20it%20was%20some%20sort%20of%20divine%20intervention.,IH,C[FB,FB,FA,FB],B0,IA,Sspawn,I~B][S39128c7c-c175-4bde-be0c-82444c411f85,B1,SSecret%20of%20the%20Skies,SOnce%20a%20popular%20spot%20to%20visit%2c%20world%20renown%20for%20it%27s%20banquets%20and%20dances%2c%20the%20Grand%20Castle%20of%20Forgo%20Kingdom%20is%20now%20barred%20to%20entry.%20Can%20you%20find%20it%27s%20secret%20entrance%20amidst%20the%20shattered%20skies%20of%20this%20Lost%20Kingdom%3f,IJ,C[FB,FB,FA,FB],B1,IA,Sspawn,I~B][S5a77e1a7-7dbd-485b-9b18-a267bbd8c009,B1,SUnnamed%20Shine,S,IK,C[FB,FB,FA,FB],B1,IA,Sspawn,I~B][Se568d0ea-f616-4a8e-90b9-5885aca413f5,B1,SUnnamed%20Shine,S,IL,C[FB,FB,FA,FB],B1,IA,Sspawn,I~B][Sf6aabb1e-8791-4762-b103-a7b823c6aaed,B1,SUnnamed%20Shine,S,IM,C[FB,FB,FA,FB],B1,IA,Sspawn,I~B]][[S915c1041-a2c9-463d-8794-fb96f34f5eb9,SThis%20Star%20Coin%20is%20locked%20away%20in%20the%20Central%20Castle.,C[FB,FB,FA,FB]][S51304a7b-9c46-42eb-b83a-115d126f471c,SMake%20your%20way%20through%20the%20underground%20maze%20and%20collect%20your%20caged%20reward%21,C[FB,FB,FA,FB]][S92d91abb-a18e-474e-9d32-3bd817a4f0ec,SThe%20bridge%20has%20collapsed%20and%20revealed%20a%20path%20to%20a%20Star%20Coin%21,C[FB,FB,FA,FB]][S10fe513f-184f-42e8-ad80-531e52df4991,SThere%27s%20a%20Star%20Coin%20at%20the%20base%20of%20the%20spire.%20But%20how%20do%20you%20reach%20it%20when%20it%20is%20so%20high%20off%20the%20ground%3f,C[FB,FB,FA,FB]][Sbd80d3b7-f5c0-4bf3-bcbf-a7cac4c15b00,SUp%20in%20the%20clouds%20among%20shattered%20structures.,C[FB,FB,FA,FB]][S9f4a6c6f-f53c-4122-afde-4e5e9c6550a3,SA%20Star%20Coin%20is%20in%20the%20furthest%20reaches%20of%20the%20castle.%20Try%20climbing%20up%20one%20of%20the%20watchtowers%20to%20get%20a%20better%20view%21,C[FB,FB,FA,FB]][S34c9b0bd-91eb-4af9-ba5e-985654c17140,SUse%20the%20Launch%20Star%20in%20the%20garden%20to%20blast%20over%20the%20castle%27s%20roof%21,C[FB,FB,FA,FB]][S028b3939-b2de-4cf6-81e8-1f0591ccf94a,SAbove%20the%20throne%20room%2c%20by%20a%20grand%20chandelier.,C[FB,FB,FA,FB]]][II][A[S58bd6a00-7922-420b-9f11-541b2032f4cc,Se7d8bb13-71ff-46df-a11c-0a929910fcb3,S809ef7e6-c17e-49a3-af1e-6c4304714bc1,S767561f9-c3fe-4559-9240-2bb98d653bc3,Sebca6b6e-d0b7-4a8d-966c-d094fed5160e,S84e1c4cc-d5eb-4b31-a00d-fb651136ccf7,S39128c7c-c175-4bde-be0c-82444c411f85],A[IB,IB,IB,IB,IB,IB,IB]][B0][]]}[[{R[FA,FA,FJE,F8],SKingdom%20Grounds,ID,IB,IA,FA,FH.2C,FA,IIB,S,IA,IA,B1,SCustom%20Song,SUnknown%20Author,B1,F~B,B0}[[{FuL,V[FA,FA],B1,C[FB,FB,FB,FB],IA,B0,aS[],FB,SParallax,B0,S5cd41f52-8f65-4620-82ec-4dffb83c094a,B1,IA,I~B,I~B}[T[YBAADADAAeJxjYBiMQICBSYCZiTT1qAi_OQJMqOqZmbCYg6oR03BcgmiyxAiOqh8o9QBZaQShAwADACsAeJwTYGASwI-YmRgYGASYCCkjSTtuQThAlsIviCZLjOCo-lH1EAAAxPkHGwIAAwA-AHick2ZgkiYCCcAQEwMLfiSApJgo9Uwo6klyDJHqGRgYIIqBDILuQfYFGeqJcQ_cC3RQP-pfPAioHgD_2BHeBQADACYAeJxjYCAMBJiYBBigiHiVxKgn1XyEFhLVw7WMqh9Vj6weAPCoAukGAAMAKQB4nBNgYBKgNWJmYmBgEGAiShBIMsAAshR-QTRZYgRH1Y-qBwIANpUHTAcAAwAqAHicE2BgEkBCDISAAInqQVqYULQIMJNmCzFWwLUQqXhU_ah6CAAA1sgDHgQABAAeAHicY2BAAAEGJiBiQAVYBQeneuINGQWjAAIAQwsBRQMABAAiAHick2ZgkoYhATBiQAVogtJI6hmIAINN__6Fz9iIAIgux8Au8ASTQGAAwAwAHicY2CAAiYGFmIQA4nqpRmYsCJS1VMLEelsshGt3T_Y_AtJDMS7hz7qiQcAsGURBwEAAwAmAHick2ZgkiYFMTGw0BSh28iIhAg6jxFVy2Bw_0CjUf_iRwDo3BL5AoADACoAeJxjYBgUQJqBCYIGiXoIYGJgIV4lBBFvOKnuobV6Ut1PqvrBCQB6SAHkAAAEABkAeJxjYCAWSDMwARHRyoe8-_IDVg9QpJ6YlRSon7wIHhSISbxoCkjWz0eAAAbOA2vCwADADIAeJxjYBgFOAETAwtRyhhZoIim6hlIUQ9WLA30AUHFDCzIa