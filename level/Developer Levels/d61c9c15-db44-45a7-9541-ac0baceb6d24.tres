code = "[{[SWarp%20Palace,STabs,SWelcome%20to%20the%20ancient%20and%20mysterious%20Warp%20Palace%21%20In%20this%20campaign-esque%20level%2c%20you%20must%20use%20the%20three%20magical%20paintings%20to%20travel%20to%20distinct%20locales%20and%20collect%20their%20Shine%20Sprites.%20,Swpthumb,II,IA,IA,IlB][[[S2458e61f-ead1-4141-8611-abf3bc6898ae,B1,SLight%20the%20House%20at%20Cape%20Coral,SThe%20beacon%20of%20the%20lighthouse%20at%20Cape%20Coral%20has%20lost%20it%27s%20power%21%20Go%20collect%20the%205%20shine%20shards%20spread%20on%20the%20coast%20to%20power%20it%20back%20up%20again.,IA,C[FB,FB,FA,FB],B0,IA,Sspawn,IA][S932adbd6-58f4-4d64-a878-a1ae27901001,B1,SScale%20the%20Magma%20Tower,SIn%20the%20northwest%20of%20the%20Magma%20Mountains%20lies%20a%20long%20abandoned%20tower%20containing%20a%20shine%20sprite%2c%20all%20though%20it%20being%20abandoned%20doesn%27t%20mean%20it%27s%20not%20filled%20to%20the%20brim%20with%20lava%20and%20flamethrowers.,IA,C[FB,FB,FA,FB],B0,IA,Sspawn,IB][S3d1cbd5d-deb0-4ec9-ad65-1a93d4c7c7f7,B1,SCastle%20Grounds%20Stroll,SThe%20citizens%20of%20the%20castle%20grounds%20have%20welcomed%20Mario%20by%20scattering%20red%20coins%20for%20him%20to%20collect%20in%20their%20houses%21%20Find%20them%20all%20to%20claim%20a%20Shine%20Sprite.,IA,C[FB,FB,FA,FB],B0,IA,Sspawn,IC][S8f3b941c-f22f-432f-b21d-de77a69ade3a,B1,SSecret%20of%20the%20Waterfall,SThe%20waterfall%20is%20clearly%20hiding%20something...%20but%20oh%2c%20how%20are%20you%20going%20to%20get%20behind%20those%20bars%3f,IA,C[FB,FB,FA,FB],B0,IA,Sspawn,ID][S89f6c6e7-1c66-4cae-a687-edec0ab75071,B1,SInto%20the%20Volcano%20Core,SWithin%20the%20depths%20of%20the%20mountains%2c%20you%27ll%20find%20a%20lot%20of%20dangerous%20traps%20and%20shifting%20magma...,IA,C[FB,FB,FA,FB],B0,IA,Sspawn,IF]][[S0e9f6dbc-bbc0-44ab-a116-a807c934a48c,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sfb7c8288-ee91-4422-bb23-d44ab3d613f6,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sceb