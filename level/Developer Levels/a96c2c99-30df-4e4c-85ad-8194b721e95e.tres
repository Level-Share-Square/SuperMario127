script = ExtResource( 1 )
code = "[{[STorrent%20Park,SLinktober,SThousands%20of%20years%20ago%2c%20there%20was%20a%20city%20deep%20out%20in%20the%20ocean.%20It%20was%20a%20thriving%20city%2c%20ruled%20by%20one%20of%20the%20most%20powerful%20civilizations%20during%20its%20time.%20One%20night%2c%20%20the%20city%20and%20all%20of%20it%27s%20inhabitants%20disappeared%20without%20a%20trace.%20Rumor%20had%20it%20that%20the%20whole%20city%20was%20swallowed%20by%20the%20ocean%2c%20presumably%20after%20angering%20a%20higher%20being.%20%0a%0aUpon%20recent%20rediscovery%2c%20it%20was%20found%20that%20other%20creatures%20had%20found%20it%20first.%20Seeking%20respite%20here%20from%20the%20harsh%20sea%20beyond%20the%20seamount%2c%20it%20was%20rebuilt.%20The%20ruins%20were%20transformed%20into%20a%20waterpark%20of%20sorts%2c%20where%20palm%20trees%20grow%20and%20birds%20fly.%20Several%20treasures%20are%20scattered%20around%20for%20adventurers%20to%20find%2c%20but%20beware%21%20There%20are%20rumors%20that%20Torrent%20Park%20is%20cursed.%20Adventure%20carefully%21,Stpthumb,IH,IT,ID,IkB][[[S9a0b42cc-dee5-432b-87ce-ca3ccd2a9ca0,B1,SBeachcombing%20for%20Shine%20Shards,SCollect%205%20Shine%20Shards%20by%20the%20basalt%20beach.,ID,C[FB,FB,FA,FB],B0,IA,Sspawn][S90ca4674-ec51-493e-b8f2-6ce139494271,B1,SThe%20Caged%20Shine,STake%20a%20Ghost%20Pepper%20to%20the%20beach%21,IB,C[FB,FB,FA,FB],B0,IA,Sspawn][S63bdace1-4cb8-4b34-950e-2476891c598b,B1,SBuried%20Treasure,SDig%20up%20the%20buried%20treasure%2c%20P%20marks%20the%20spot%21,IC,C[FB,FB,FA,FB],B0,IA,Sspawn][S02285f58-43b6-490e-ae32-bc77804644b0,B1,SRed%20Coin%20Rapids,SCollect%20all%208%20red%20coins%20across%20the%20park.,IF,C[FB,FB,FA,FB],B1,IA,Sspawn][Se493c965-b3bb-485e-b683-1bfe97a2c285,B1,SFort%20Jelectro,SClimb%20the%20Jelectro%20Fort%20on%20top%20of%20the%20park%21,IA,C[FB,FB,FA,FB],B0,IA,Sspawn][Sf5b3d49a-adbd-4e80-837a-606c2164d9b8,B1,SSand%20Castle%20Secret,SSomeone%20tried%20a%20bit%20too%20hard%20on%20their%20sand%20castle.%0a,IG,C[FB,FB,FA,FB],B1,IA,Ss