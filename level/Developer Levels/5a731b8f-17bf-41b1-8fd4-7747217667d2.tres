code = "[{[STutorial%20Hills,SSamitizer,SWelcome%20to%20Tutorial%20Hills%21%20This%20level%20will%20show%20you%20the%20basics%20of%20how%20to%20play%20Super%20Mario%20127.%20This%20level%20contains%205%20Shine%20Sprites%20in%20total%2c%20but%20feel%20free%20to%20move%20on%20to%20other%20levels%20if%20you%20get%20stuck.%20You%20can%20always%20come%20back%20and%20grab%20the%20rest%20later%21%0a%0aNeed%20more%20help%3f%20Come%20ask%20us%20in%20our%20Discord%21%20You%20can%20join%20by%20pressing%20the%20Discord%20icon%20on%20the%20title%20screen%20%2813%2b%20only%29.,Sththumb,IB,IB,IA,IlB][[[Sda11af23-2a35-4500-9927-77887f8d93af,B1,SShine%20Sprite%20on%20Tutorial%20Hills,SThis%20Shine%20Sprite%20sits%20atop%20Tutorial%20Hills%21,IA,C[FB,FB,FA,FB],B1,IA,Sspawn][Sc5edadcd-fd92-4875-9753-cd6832aede6b,B1,SWing%20Mario%20in%20the%20Sky,SGrab%20a%20Super%20Feather%20and%20glide%20through%20the%20sky%21,IB,C[FB,FB,FA,FB],B1,IA,Sspawn][S971d3309-f206-4364-9202-5d0de92504a2,B1,SShine%20Shards%20%in%20the%20Cave,SCollect%205%20shine%20shards%20to%20get%20a%20shine%20sprite.%20,ID,C[FB,FB,FA,FB],B1,IA,Sspawn][S145ebb72-5c76-46d5-83a8-ee715916a8e2,B1,SSecret%20of%20Tutorial%20Hills,SThis%20shine%20is%20hidden%20somewhere%20in%20the%20level.%20You%20might%20need%20a%20special%20power%20to%20get%20it.,IF,C[FA,FB,FA,FB],B1,IA,Sspawn][S38072c2a-63a4-4724-a54d-a0cf4f020ac1,B1,SCollect%208%20Red%20Coins,SThere%20are%208%20red%20coins%20scattered%20around%20the%20level%2c%20collect%20them%20all%20for%20a%20shine%20sprite.,IE,C[FB,FB,FA,FB],B1,IA,Sspawn]][[S2c86fe06-b961-4c6a-af3c-91d2f9845a32,SAbove%20the%20water%20canal.,C[FB,FB,FA,FB]][S9f872b3e-30f0-4d5f-9b81-be5eb69857c5,SHanging%20on%20the%20face%20of%20a%20cliff.,C[FB,FB,FA,FB]][S92689105-5fd5-4413-9d4a-326a17276b70,SFly%20high%20in%20the%20sky%21,C[FB,FB,FA,FB]][S931911a6-fb71-4a69-9645-d3db4f2802c6,SA%20tricky%20jump%20in%20a%20cave.,C[FB,FB,FA,FB]][S4a0c4bd1-cb6c-4e37-90e3-be27a3b00247,SBehind%20a%20secret%2c%20underground%20cage