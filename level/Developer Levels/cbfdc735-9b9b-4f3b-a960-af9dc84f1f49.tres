code = "[{[STutorial%20Hills,SSamitizer,SWelcome%20to%20Tutorial%20Hills%21%20This%20level%20will%20show%20you%20the%20basics%20of%20how%20to%20play%20Super%20Mario%20127.%20This%20level%20contains%205%20Shine%20Sprites%20in%20total%2c%20but%20feel%20free%20to%20move%20on%20to%20other%20levels%20if%20you%20get%20stuck.%20You%20can%20always%20come%20back%20and%20grab%20the%20rest%20later%21%0a%0aNeed%20more%20help%3f%20Come%20ask%20us%20in%20our%20Discord%21%20You%20can%20join%20by%20pressing%20the%20Discord%20icon%20on%20the%20title%20screen%20%2813%2b%20only%29.,Sththumb,IB,IB,IA,IkB][[[S05746286-7a43-4f29-ae19-e0e85a619e21,B1,SShine%20Sprite%20on%20Tutorial%20Hills,SThis%20Shine%20Sprite%20sits%20atop%20Tutorial%20Hills%21,IA,C[FB,FB,FA,FB],B1,IA,Sspawn][S8dba8a37-4ffc-4638-b97e-96ffb817736a,B1,SWing%20Mario%20in%20the%20Sky,SGrab%20a%20Super%20Feather%20and%20glide%20through%20the%20sky%21,IB,C[FB,FB,FA,FB],B1,IA,Sspawn][S902d23e7-d4af-4e03-8780-33a847c093a3,B1,SShine%20Shards%20%20in%20the%20Cave,SCollect%205%20shine%20shards%20to%20get%20a%20shine%20sprite.%20,ID,C[FB,FB,FA,FB],B1,IA,Sspawn][S7fd1ef99-8de0-47c9-82ef-efa7a1a92d78,B1,SSecret%20of%20Tutorial%20Hills,SThis%20shine%20is%20hidden%20somewhere%20in%20the%20level.%20You%20might%20need%20a%20special%20power%20to%20get%20it.,IF,C[FA,FB,FA,FB],B1,IA,Sspawn][S50cd7648-88b0-4802-8e63-7679d2acae65,B1,SCollect%208%20Red%20Coins,SThere%20are%208%20red%20coins%20scattered%20around%20the%20level%2c%20collect%20them%20all%20for%20a%20shine%20sprite.,IE,C[FB,FB,FA,FB],B1,IA,Sspawn]][[S2bd340bf-b195-4f9f-9d8f-404648a4bfcd,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sd8e4549c-6d79-404d-adc2-d00fa270331f,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][S6731809c-9d6f-445c-9151-a48787c9467e,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sfcd13848-83cc-4df3-9996-e5ffe9b5c16c,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Se9c294f7-f864-4e04