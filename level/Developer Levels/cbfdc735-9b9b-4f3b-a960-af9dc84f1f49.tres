code = "[{[STutorial%20Hills,SSamitizer,SWelcome%20to%20Tutorial%20Hills%21%20This%20level%20will%20show%20you%20the%20basics%20of%20how%20to%20play%20Super%20Mario%20127.%20This%20level%20contains%205%20Shine%20Sprites%20in%20total%2c%20but%20feel%20free%20to%20move%20on%20to%20other%20levels%20if%20you%20get%20stuck.%20You%20can%20always%20come%20back%20and%20grab%20the%20rest%20later%21%0a%0aNeed%20more%20help%3f%20Come%20ask%20us%20in%20our%20Discord%21%20You%20can%20join%20by%20pressing%20the%20Discord%20icon%20on%20the%20title%20screen%20%2813%2b%20only%29.,Sththumb,IB,IB,IA,IlB][[[S4ac5f452-8877-43b1-ba32-ba734a4435c6,B1,SShine%20Sprite%20on%20Tutorial%20Hills,SThis%20Shine%20Sprite%20sits%20atop%20Tutorial%20Hills%21,IA,C[FB,FB,FA,FB],B1,IA,Sspawn,IA][S8ef29ece-a212-450b-866b-881ef19bd8ad,B1,SWing%20Mario%20in%20the%20Sky,SGrab%20a%20Super%20Feather%20and%20glide%20through%20the%20sky%21,IB,C[FB,FB,FA,FB],B1,IA,Sspawn,IB][S61d0d7e3-98cf-4ae3-8b39-340fc6464105,B1,SShine%20Shards%20%20in%20the%20Cave,SCollect%205%20shine%20shards%20to%20get%20a%20shine%20sprite.%20,ID,C[FB,FB,FA,FB],B1,IA,Sspawn,IC][S5e99ae5c-4068-46ff-bbc6-82ebbda68801,B1,SSecret%20of%20Tutorial%20Hills,SThis%20shine%20is%20hidden%20somewhere%20in%20the%20level.%20You%20might%20need%20a%20special%20power%20to%20get%20it.,IF,C[FA,FB,FA,FB],B1,IA,Sspawn,ID][Sdb2ce919-0d35-421f-b75e-d9927baa6f15,B1,SCollect%208%20Red%20Coins,SThere%20are%208%20red%20coins%20scattered%20around%20the%20level%2c%20collect%20them%20all%20for%20a%20shine%20sprite.,IE,C[FB,FB,FA,FB],B1,IA,Sspawn,IE]][[S57e10a84-abe3-4146-98ea-e35a4d226a5f,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Seb03aa93-a9c4-4002-b683-18aebe7f4399,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][S8fe1f057-3a55-4d99-91d6-8b2bbdee7fc6,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sf7ea670b-ff1b-487b-a7f6-c9805daf252e,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][S33e