code = "[{[SPastel%20Citadel,SRudy12345mc,S%22Hop%20across%20the%20cloudy%2c%20pastel%20skyline%2c%0aExplore%20the%20floating%20chasms%2c%20drifting%20and%20divine%2c%0aJump%20up%20high%2c%20soar%20in%20the%20sky%2c%20for%20you%20may%20find%2c%0aVibrant%20rainbow%20artifacts%2c%20sprites%20that%20always%20shine.%22%0a-Edgar%20Allan%20Toad,Spcthumb,IK,IA,IA,IlB][[[Sbb379b5d-2d94-4e4d-833c-fd7044ecfd1c,B1,SLavender%20Arches%20Speedrun,SA%20mysterious%20purple%20cloud%20floats%20to%20the%20left%20of%20the%20Citadel.%20The%20button%20on%20top%20opens%20the%20path%20to%20another.%20Zoom%20from%20one%20end%20of%20the%20level%20to%20the%20other%20to%20claim%20your%20prize%21,IC,C[FA.sC,FA.ZC,FB,FB],B1,IA,Sspawn][S4f963481-7f24-4b75-8ec4-9fd8b0e066b1,B1,SRed%20Coins%20on%20the%20Big%20Blossom,SIn%20the%20center%20of%20the%20Citadel%20lies%20a%20huge%20blossom%20tree%21%20Collect%20the%20Red%20Coins%20scattered%20across%20it.%20...Do%20trees%20normally%20grow%20clouds%3f,IA,C[FB,FA.R,FA.2C,FB],B1,IA,Sspawn][S3606a711-b1e7-40a1-bbc3-2b2c841e90b9,B1,SGreenhouse%20Ascent,SOn%20the%20eastern%20side%20of%20the%20Citadel%20lies%20a%20very%20tall%20greenhouse%2c%20keeping%20many%20of%20it%27s%20plants%20in%20good%20health.%20A%20Shine%20Sprite%20waits%20for%20you%20at%20the%20top.,ID,C[FA.OC,FB,FA.O,FB],B1,IA,Sspawn][Se1d47650-26b5-4102-9b56-8fa6594094a8,B1,SToll%20Tower,SThe%20bright%20Toll%20Tower%20only%20opens%20to%20those%20with%20a%20strong%20enough%20value.%20Collect%20a%20hefty%20sum%20of%20300%20coins%20to%20open%20the%20door.,IB,C[FB,FA.9C,FA._B,FB],B1,IA,Sspawn][Sa24811ae-0738-49b9-a291-28a1340256cb,B1,SGhost%20Pepper%20Sprint,SFind%20a%20Launch%20Star%20tucked%20away%20in%20the%20Citadel%20and%20get%20whisked%20away%20to%20a%20hidden%20challenge.%20Dash%20from%20pepper%20to%20pepper%20before%20time%20runs%20out%21,IE,C[FB,FB,FB,FB],B1,IA,Sspawn]][[Se7b93fab-7d9e-4b36-9657-233193155377,SAbove%20the%20entryway.,C[FB,FA.E5lF,FA.Twm,FB]][S307d25c9-2ce1-4c91-84e7-cb2f70d71ef