code = "[{[SThe%20Fruity%20Archipelago,SFireflower,SHome%20of%20the%20great%20fruit%20tree%2c%20this%20island%20has%20water%20that%20tastes%20like%20fruit%20punch%20and%20giant%20fruits%20that%20come%20from%20the%20great%20fruit%20tree.%20Yoshis%20have%20been%20on%20this%20island%20because%20of%20the%20enormous%20fruit.%20You%20too%20should%20check%20it%20out%2c%20and%20maybe%20collect%20some%20shines%20while%20you%20are%20there.,Shttps%3a%2f%2ffile.garden%2fZqhhKH15RExrNTgK%2fLSS%2fThumbnails%2fThe%2520Fruity%2520Archipelago%2520%281%29.png,II,IV,IA,IlB][[[S51f51633-5218-441f-8630-71766e354bf3,B1,SBreak%20the%20Giant%20Watermelon%21,SThere%20is%20a%20giant%20watermelon%20floating%20in%20the%20sea.%20%0aIt%20is%20too%20hard%20to%20break%20with%20normal%20means%2c%20but%20being%20as%20strong%20as%20steel%20could%20help%20you%20break%20it.,IA,C[FB,FA,FA,FB],B0,IA,Sspawn][Sb2a76f07-6f31-4b66-b74e-83cd39d4f4fd,B1,SFruity%20Reds,SCollect%20the%20Red%20Coins%20scattered%20through%20the%20isles%2c%20particularly%20on%20reddish%20types%20of%20fruit.,IA,C[FB,FA,FA,FB],B0,IA,Sspawn][S5d55047d-b975-4d92-bf93-1273e4edf0c1,B1,STop%20Banana,SHigh%20up%20in%20the%20giant%20fruit%20tree%2c%20there%20is%20a%20huge%20bunch%20of%20bananas.%20%0aToo%20bad%20the%20nippers%20here%20like%20potassium.,IA,C[FB,FB,FA,FB],B0,IA,Sspawn][Sd324d084-4f97-4830-9be9-e4bcde3da1ea,B1,SSpeedy%20Sea%20Grapes,SSwim%20through%20all%20the%20sea%20grapes%20with%20the%20ghost%20pepper.%20Each%20grape%20will%20extend%20your%20time%2c%20so%20take%20advantage%20of%20that.,IA,C[FB,FA.fC,FA,FB],B0,IA,Sspawn][S52c42c75-ad55-404c-b707-32f422e26889,B1,SInquizitive%20Kiwi,SFind%20answers%20to%20the%20kiwi%e2%80%99s%20questions.%20Maybe%20a%20bit%20of%20exploration%20is%20needed%20to%20answer%20these%20questions.,IA,C[FA,FB,FA,FB],B0,IA,Sspawn][S87b04b8e-4ad9-4d3b-bd85-86bf74240947,B1,SThe%20Coconut%20Club,SThere%20seems%20to%20be%20a%20high-class%20club%20inside%20a%20giant%20coconut.%20Maybe%20if%20you%20had%20enough%20coins%2c%20you%20could%20join.,IA,C[FB,FB,FB,FB],B0,IA,Sspawn][S78f9ac61-a555-4264-9f79-b639ce724c16,B1,SStar%20Fruit%20Sky,SFly%20high%20into%20the%20sky%20and%20collect%20a%20bunch%20of%20star%20bits.%20Thankfully%2c%20the%20sunset%20sky%20is%20full%20of%20them.,IA,C[FA.fC,FB,FA,FB],B0,IA,Sspawn][S5c96161b-d26c-4a22-bfc3-f33cb2762397,B1,SWilliam%20Tell,SAim%20the%20cannon%20directly%20at%20the%20center%20of%20the%20apple.%20%0aThankfully%2c%20the%20apple%20is%20straight%20from%20the%20tree%2c%20and%20not%20on%20top%20of%20a%20loved%20one.,IA,C[FA,FB,FA,FB],B0,IA,Sspawn]][[Sc301f26f-61dd-46fd-8077-57c111049831,SOn%20top%20of%20a%20green%20apple.,C[FA.BRJE,FB,FA.ZcoE,FB]][S64d7656b-c247-4e5a-8764-4554867d3aa9,SEnter%20the%20hydra%21,C[FB,FB,FB,FB]][Sc1f4a9e8-cbeb-440c-93c6-2c7a633e02ab,SRooted%20under%20a%20sea%20grape.,C[FA.loRF,FB,FA.3xeF,FB]][Se782234e-b560-45e7-a7cb-547cb36ae422,SA%20reward%20for%20getting%20all%20500%20star%20bits.,C[FB,FA.Ti-D,FA.ShUG,FB]]][IH][A[S51f51633-5218-441f-8630-71766e354bf3,Sb2a76f07-6f31-4b66-b74e-83cd39d4f4fd,S5d55047d-b975-4d92-bf93-1273e4edf0c1,Sd324d084-4f97-4830-9be9-e4bcde3da1ea,S52c42c75-ad55-404c-b707-32f422e26889,S5c96161b-d26c-4a22-bfc3-f33cb2762397,S87b04b8e-4ad9-4d3b-bd85-86bf74240947,S78f9ac61-a555-4264-9f79-b639ce724c16],A[IB,IB,IB,IB,IB,IB,IB,IB]][B0][SHoverNozzle,SRocketNozzle,STurboNozzle]]}[[{R[FA,FA,FWD,FUB],SFruit%20Filled%20Isle,II,IV,IC,FA,FH.2C,FA,Ix,S,IG,IA,B1,SCustom%20Song,SUnknown%20Author,B0,F~B,B1}[[{FA,V[FA,FA],B0,C[FA.KO5F,FA.KO5F,FA.KO5F,FB],IA,B0,aS[],FB,SVery%20Back,B0,S22d25c18-cd4d-44c7-bb47-736bdd04df3a,B1,IA,I~B,I~B}[T[YBAAAACwAeJxjYCAWqIER8QCiXo0RHZGqHiciVT0jivuJ1EKqf4eoenh4jjT1AJtsDIkFAAAAMwB4nFNjYFAjAsEBMYpHrHo1RmLVg1Qy0lA9qe4Hmjzw6hnJV0_AvxihJ8XAClEPAA3LILIDAAAAGwB4nGNgIBmoMRJAtNBLhl1YNY6CUYAMADdfBVYGAAAAIQB4nGNgGHpAjRGBCCpAQwQVkKSSDLdhVT8KBgoAACt4BkAHAAAAFQB4nGNgGFxAjRGERsEooA8AAMCpAE8EAAEANwB4nGNgIAqoMTKoMYAQkQCuHsRAQqSqx6WXGPXoCMn9pKpHt5oU9fj9O6qeuurxpDGs6gEakQ4zBQABADQAeJxTY2BQw0SMS