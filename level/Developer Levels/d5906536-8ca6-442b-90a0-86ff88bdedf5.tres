script = ExtResource( 1 )
code = "[{[SWet-Freeze%20Cave,SFlarewire,SExplore%20two%20varied%20caverns%20in%20this%20underground%20expedition%21%20In%20the%20first%20cave%2c%20explore%20the%20frigid%20ruins%20of%20a%20society%20lost%20to%20time.%20In%20the%20second%20cave%2c%20use%20the%20magical%20crystal%20taps%20to%20reach%20the%20top%20and%20claim%20your%20prize%21,Swfcthumb,IE,IJ,ID,IlB][[[S8394a3cf-f604-45b3-8d8b-9b04d1a09002,B1,SThe%20Underground%20Town,SInside%20a%20hole%20near%20the%20Forest%20Islands%2c%20you%20can%20find%20an%20underground%20town%20made%20of%20icy%20cold%20bricks%21%20Use%20note%20blocks%20to%20get%20to%20the%20top%2c%20and%20grab%20the%20treasure.,IA,C[FB,FB,FA,FB],B1,IA,Sspawn,IA][S2cca838d-1bfb-42ff-8d08-e5fa25246482,B1,SP-Switch%20Speedrun,SThese%20fantastical%20magic%20switches%20can%20make%20blocks%20disappear%21%20Unfortunately%2c%20it%20only%20lasts%20for%20a%20short%20amount%20of%20time.%20Better%20be%20quick%21,IA,C[FB,FB,FA,FB],B1,IA,Sspawn,IB][S9cef0cb4-454c-4711-a11e-175ac89c55a0,B1,SShine%20Shards%20on%20Forest%20Islands,SAround%20the%20floating%20islands%20in%20this%20cave%2c%20you%20can%20find%20pieces%20of%20a%20shine%20sprite.%20Collect%20all%205%20of%20them%2c%20and%20something%20cool%20might%20happen%21,IA,C[FB,FB,FA,FB],B1,IA,Sspawn,IC][S70c0543a-f859-46ee-8f68-244055d86921,B1,STop%20of%20the%20Cave,SUse%20Crystal%20Taps%20to%20rise%20the%20water%20level%20and%20swim%20to%20the%20top%21%20The%20arrows%20will%20help%20guide%20your%20way.,IA,C[FB,FB,FA,FB],B1,IA,Sspawn,ID][S37a05053-4e6a-4d42-b2ed-611f5634b83c,B1,SGhost%20Pepper%20Water%20Race,SInside%20one%20of%20the%20doors%20in%20the%20Wet%20Rock%20Cave%2c%20you%20can%20find%20an%20abandoned%20race%20track.%20The%20prize%20has%20been%20left%20untouched%20for%20centuries%21,IA,C[FB,FB,FA,FB],B1,IA,Sspawn,IG][Sc635d611-8da5-470d-8e0f-1815fa29c0b3,B1,SSecret%20In%20The%20Rocks,SMany%20rumors%20about%20the%20Wet%20Rock%20Cave%20describe%20hidden%20pipes%2c%20which%20take%20you%20to%20alternate%20dimensions.%20These%20dimensions%20are%20said%20to%20have%20very%20valuable%20treasure%20stashed%20inside.,IA,C[FB,FB,FA,FB],B1,IA,Sspawn,IF]][[Sb8baf3e4-9ab7-4ef1-b4f9-813e755cf1c8,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sfe85ecf8-82c0-433e-85b9-b0eda716c7fa,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sd3aaf9d2-3e0a-4ab7-9c25-4d0e9075e153,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sd1861286-06f7-4c0f-9bb4-fbb2f843f710,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][S72cfb0a1-0865-438d-9f2f-61f7bfb9ad1e,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sd4f6c845-33f8-44c4-b0e4-e8ab89da4b2a,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]]][IA][A[S8394a3cf-f604-45b3-8d8b-9b04d1a09002,S2cca838d-1bfb-42ff-8d08-e5fa25246482,S9cef0cb4-454c-4711-a11e-175ac89c55a0,S70c0543a-f859-46ee-8f68-244055d86921,S37a05053-4e6a-4d42-b2ed-611f5634b83c,Sc635d611-8da5-470d-8e0f-1815fa29c0b3],A[IB,IB,IB,IB,IB,IB]][B0][]]}[[{R[FA,FA,FMC,Fy],S,IE,IJ,ID,FA,FH.2C,FA,IP,S,IF,IA,B0,SCustom%20Song,SUnknown%20Author,B0,F~B,B1}[[{FA,V[FA,FA],B0,C[FA.KO5F,FA.KO5F,FA.KO5F,FB],IA,B0,aS[],FB,SVery%20Back,B0,S169498cf-e803-401d-84a0-38165b2f6ca1,B1,IA,I~B,I~B}[T[YAAAAAEkAeJxjZ2RgJ4SQATFq8KvHA6BqMHQRMBlVhEhn4DGc-NAgw3A09ZhcItXjApimYRqORwpTnGB6ICkESEpsBE0mPn3isgUAtrcElwEAAAAyAHicY2BgYGfEhzAB7RRjVY8fkKQYWT2RgCTFEPWDBJDhTZICkKB6UqMSTQt9AAAK-wIJAwAAADQAeJxjYAABdkZiES5Aqnpc2kkCpKqHW0SqejIcRp5FVATEG0hSfJGnmCRnUF0xHi0AOTsB0QQAAAAxAHicY2dkYGdkIB6wM2JBpKqnIiLVOpIAqerpAEj1CBnhQGEY0kcLVhOItwUOAP4NAvkFAAAAKgB4nGNgwALYGXEirGpwacFvFEFj8avErx4XIF7lKBhwQFLskBebAJCvAekGAAAAXwB4nJWRUQqAMAxDOxF2DPH-l1SIlNCWEEO_ttdH2CJU9vrmihPjwODvODT_188rpp95048Vx5_l3wg_Pwvz3d9JwN0_koVnv8OnX8DJ684mXw5L0Ge8GuP_L-cB9osHgAcAAABfAHicY2dkYMdA8gwsDGAA4eICyOohCNMorACoUpGBiST1EITFamYWdMVMLHDz8RiFFRGvHqf5ONyDaT4x4YPpX1zq4ebTNPwJqsTlfkyjqBL-cJcguwrTkXjSJwC7lAylCAAAAE8AeJxjYGCQZ2CBIHZGBkwAFEfmAtUARRQZmNDE8auHImZ0LfJMLHjMx4Uwbc