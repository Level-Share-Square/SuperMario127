code = "[{[SBoxton,SLinktoberton,SA%20once%20bustling%20city%20is%20now%20a%20shell%20of%20it%27s%20former%20self.%20Covered%20in%20a%20thick%20veil%20of%20fog%2c%20and%20overran%20by%20a%20new%20strange%20type%20of%20organism%20named%20Cortex%20Cerritulus.%20It%27s%20brittle%2c%20yet%20it%20regenerates%20itself%20quickly%20when%20not%20being%20observed.%20The%20city%20still%20has%20goods%20to%20be%20recovered%2c%20are%20you%20up%20for%20the%20task%3f,S,IJ,IU,IA,IlB][[[S5d69b266-7030-41d2-b37a-9adcb9c34437,B1,SCity%20Red%20Coins,SAcross%20the%20city%2c%20inside%20and%20out%2c%20are%208%20Red%20Coins.,IA,C[FB,FB,FA,FB],B1,IA,Sspawn][S4ea4d8cf-5d18-4934-9d2f-33c5695c8484,B1,SMetal%20Cap%20Robbery,SThe%20old%20bank%20still%20has%20a%20couple%20of%20coins%20left%2c%20wouldn%27t%20hurt%20to%20snag%20a%20few.,IA,C[FB,FB,FA,FB],B1,IA,Sspawn][S2ac8a6f7-1ba5-45de-ba9d-0bef49dfa44d,B1,SCoastal%20Tower,SIt%20was%20under%20construction%2c%20probably%20not%20getting%20finished%20up%20anytime%20soon%20either.,IA,C[FB,FB,FA,FB],B1,IA,Sspawn]][[S5bedfb7d-a9a9-458d-aefe-040f440c5c4b,SThis%20Star%20Coin%20floats%20high%20above%20the%20city%20atop%20a%20brittle%20tower...,C[FB,FB,FA,FB]][S6dbfddfc-ee3a-4de9-96f7-c7cbdac394a7,SA%20Star%20Coin%20is%20waiting%20at%20the%20edge%20of%20the%20city...,C[FB,FB,FA,FB]][Sd421b66c-d38e-4a6b-860b-7b7e1a9bec35,SKeep%20jumping%20off%20the%20walls%20until%20you%20hit%20the%20ceiling%21,C[FB,FB,FA,FB]]][II][A[S5d69b266-7030-41d2-b37a-9adcb9c34437,S4ea4d8cf-5d18-4934-9d2f-33c5695c8484,S2ac8a6f7-1ba5-45de-ba9d-0bef49dfa44d],A[IB,IB,IB]][B0][SHoverNozzle,SRocketNozzle,STurboNozzle]]}[[{R[FA,FA,F_C,Fe],SMy%20Area,IJ,IU,IA,FA,FH.2C,FA,IU,S,IA,IA,B0,SCustom%20Song,SUnknown%20Author,B0,F~B,B1}[[{FA,V[FA,FA],B0,C[FA.KO5F,FA.KO5F,FA.KO5F,FB],IA,B0,aS[],FB,SVery%20Back,B0,Sa0e6e5ed-feec-44af-bd85-3fb885cefdf0,B1,IA,I~B,I~B}[T[YCgAAADkAeJxjYBgFIMDIwApB-GXhCohXD1HDCEM41KMggkCDCDWUqKcKwB9EFKpXZWQjPrgg6rGKAwAyxAEyBAABACUAeJxjYCAMGGGISDCqnkj1jFAuKzKiXD2GdlLVo9s4jAE