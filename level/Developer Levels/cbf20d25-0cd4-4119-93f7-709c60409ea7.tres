code = "[{[STangled%20Bog%20Galaxy,STabs,STravel%20through%20this%20haunted%20swamp%20infested%20by%20prickly%20vines%20and%20ghosts%20in%20this%20Super%20Mario%20Galaxy%20inspired%20level%21,S,IJ,IR,IA,IlB][[[S110bc390-52de-44e8-8207-284ef86f73bc,B1,STangled%20Shine%20Shards,SShine%20shards%20are%20spread%20throughout%20the%20grassy%20area.%20Collect%20them%20all%20while%20remaining%20wary%20of%20the%20thorny%20vines%21,IB,C[FB,FB,FA,FB],B1,IA,Sspawn][Sfafb77f2-15ea-4565-b9cc-7a75268afa3a,B1,SGreen%20Shine%20%232,SFloating...,IF,C[FA,FB,FA,FB],B0,IA,Sspawn][S4b4d2100-a9dc-4dae-80c0-21da4d28b5c7,B1,SThe%20Chimp%27s%20Bounce%20Challenge,SThe%20Chimp%20has%20sadly%20passed%20away.%20But%20that%27s%20not%20stopping%20him%20from%20challenging%20Mario%20to%20yet%20another%20wacky%20game%21,IC,C[FB,FB,FA,FB],B1,IA,Sspawn][S92e9f6a4-da74-4878-9bc8-ddf8b9c307bc,B1,SGreen%20Shine%20%233,SBounce...,IG,C[FA,FB,FA,FB],B0,IA,Sspawn][S395d684f-f0e9-497d-891c-0acc878b512a,B1,SGreen%20Shine%20%231,SLight...,IE,C[FA,FB,FA,FB],B0,IA,Sspawn][S55c5d169-0cd9-4a0b-ab81-75ee67926942,B1,STreasure%20Beneath%20the%20Bog,SSunken%20deep%20beneath%20the%20bog%20is%20an%20old%2c%20forgotten%20treasure%20chest%20containing%20a%20Shine.%20Beware%2c%20it%20is%20said%20that%20the%20deeper%20you%20go%2c%20the%20more%20haunted%20it%20gets...,IA,C[FB,FB,FA,FB],B1,IA,Sspawn][Sf3db9e3c-855e-4c75-a270-2723fb477420,B1,SSpooky%20Cosmic%20Demon%20Chase,S%21%21%21%20PRANKSTER%20COMET%20IN%20ORBIT%20%21%21%21%0aYou%20have%201%3a30%20to%20collect%20this%20shine.,ID,C[FB,FB,FA,FB],B1,IE,Sgreendemon]][[Sf4afe33c-4660-4cbc-bfb0-8d6bfbb8830c,SSwim%20down..%20waterfalls..,C[FB,FB,FA,FB]][S10eecc52-e134-43cc-ad48-281545e96b56,SWater..%20planet...,C[FB,FB,FA,FB]][S9c9aff47-5682-468f-8310-feb594aa822e,SAbove..%20launch%20star..,C[FB,FB,FA,FB]][S42e11df4-ca64-4560-94a5-bb44e6860bf5,SWater%20cave..%20Green%20demon..,C[FB,FB,FA,FB]]][IA][A[S110bc390-52de-44e8-8207-284ef86f73bc,Sfafb77f2-15ea-4565-b9cc-7a75268afa3a,S4b4d21