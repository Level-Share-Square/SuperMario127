script = ExtResource( 1 )
code = "[{[SGold%20Rush%20Gulch,SAsterocrat,SA%20long%20time%20ago%2c%20gold%20was%20struck%20in%20this%20here%20ravine%21%20Ever%20since%2c%20the%20place%20has%20been%20a%20hot%20spot%20for%20all%20manner%20of%20miners%20and%20prospectors%20looking%20to%20get%20rich%20quick%21%20The%20ravine%20coined%20itself%20the%20name%20Gold%20Rush%20Gulch.%0a%0aIn%201889%2c%20Shellpass%20Town%20was%20founded%20within%20the%20gulch%20and%20is%20home%20to%20the%20Shellpass%20Mineshaft.%20Once%20a%20quaint%2c%20humble%20little%20town%2c%20it%20recently%20gained%20a%20second%20wind%20after%20Ax%27Em-corp%20contracted%20a%20lucrative%20new%20mining%20operation.%20To%20this%20day%2c%20the%20Shellpass%20Mineshaft%20holds%20treasures%20yet%20to%20be%20discovered%2c%20and%20there%27s%20more%20gold%20to%20be%20found%20than%20ever%20before%21,Sgrgthumb,IE,IU,IF,IkB][[[S8400afea-daad-4cbb-b743-a42a2e4b9d6d,B1,SCloud%20Path%20Above%20the%20Town,SHop%20your%20way%20to%20a%20Shine%20beaming%20high%20above%20the%20desert.%20The%20path%20starts%20on%20the%20west%20side%20of%20Shellpass%20Town.,IB,C[FB,FB,FA,FB],B1,IA,Sspawn][Sfe537d92-de6e-41be-a831-9497f371d8f1,B1,SMining%20for%20Shine%20Shards,SLook%20for%20the%20five%20Shine%20Shards%20scattered%20around%20the%20vast%20chamber%20at%20the%20heart%20of%20the%20mines.,IC,C[FB,FB,FA,FB],B1,IA,Sspawn][S52a1f7f4-8d77-4466-a033-d062436e50d2,B1,SAtop%20the%20Mesa,SClimb%20the%20imposing%20mountain%20overlooking%20the%20east%20side%20of%20town.%20This%20may%20require%20a%20boost%20and%20some%20jump%20tricks...,ID,C[FB,FB,FA,FB],B1,IA,Sspawn][Sd13e6ce5-ef02-4229-85c9-2c40e45fb1d4,B1,SSecret%20of%20the%20Mines,SA%20Shine%20is%20hidden%20underground%2c%20among%20the%20caves%20and%20the%20mineshafts.%20You%20don%27t%20need%20to%20use%20a%20pipe%20to%20find%20it.,IG,C[FB,FB,FA,FB],B1,IA,Sspawn][Sef1594e4-dc75-478b-a850-b597fea7e811,B1,SShellpass%20Metal%20Rally,SGrab%20the%20first%20Power%20Gear%20in%20the%20western%20part%20of%20the%20mines%20and%20hop%20from%20gear%20to%20gear%20to%20the%20Shine%20Sprite.%20Follow%20the%20metal%20arrows%21,IE,C[FB,FB,FA,FB],B1,IA,Sspawn][S3bf85a79-52c7-4e70-8c7a-6a64d6aeaf64,B1,SShimmering%20Mine%20Depths,SHead%20to%20the%20pipe%20at%20the%20very%20bottom%20of%20the%20mines%20below%20Shellpass%20Town.%20Watch%20out%20for%20the%20vicious%20fauna%20growing%20along%20the%20way%21,IA,C[FB,FB,FA,FB],B1,IA,Sspawn][Se3a5e808-a817-4487-89e2-eb42c4511543,B1,SGuide%20the%20Rolling%20Steelies%20,SFind%20a%20way%20into%20the%20well%2c%20where%20a%20hidden%20pipe%20awaits%20you%2c%20then%20complete%20the%20secret%20challenge%20on%20the%20other%20side%21,IF,C[FB,FB,FA,FB],B1,IA,Sspawn]][[Sfd99cadb-56c6-43d7-8000-17d460ebd7ac,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][S6c12c06c-345f-49aa-a4d7-920a359f969f,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sc21875de-3f77-436f-808d-7dfaf0bc1b9c,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sf1c2f975-b4ee-448d-ae0e-7f2052561c47,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sa07ac48a-3c0a-465f-b4c4-746e81ac2dab,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]]][IA][A[S8400afea-daad-4cbb-b743-a42a2e4b9d6d,Sfe537d92-de6e-41be-a831-9497f371d8f1,S52a1f7f4-8d77-4466-a033-d062436e50d2,Sd13e6ce5-ef02-4229-85c9-2c40e45fb1d4,Sef1594e4-dc75-478b-a850-b597fea7e811,S3bf85a79-52c7-4e70-8c7a-6a64d6aeaf64,Se3a5e808-a817-4487-89e2-eb42c4511543],A[IB,IB,IB,IB,IB,IB,IB]]]}[[{R[FA,FA,FWC,FeB],S,IE,IU,IF,FA,FH.2C,FA,Iw,S,IF,IA}[[{FA,V[FA,FA],B0,C[FA.KO5F,FA.KO5F,FA.KO5F,FB],IA,B0,aI[],FB,SVery%20Back,B0,Se1754f98-8e62-4eac-9325-c73cb38930e2,B1}[T[YAQAAAB8AeJxjYBgFo2DQAX4mBn5mEhRLMoAQkVrkkBgAJUYAtQEAAQBDAHicY2AgDOQwGATVS4LREFWPDKQZGCEIlwJJVDTg6rlQEUFAqnoM7UzIiKB6ZRyIVPW4NGIqALoKSMrCEBobAOpWCeoIAAEAQgB4nGNgwAKUsSE8QJmRNPVYrcBnOCnmY1VM0D0QIMHACEfEqOdiYISjkWk-1qAWYmCCIDT1WBUjq8dEtFYPANA3DbgCAAEASwB4nGNgGDKAi4EJGVFFPbKsBAODIkgERErAFEjCGGwMDFJMDFIMMMQMVS-BQz3YcBSE33wGmBSyemQEV