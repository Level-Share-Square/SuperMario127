script = ExtResource( 1 )
code = "[{[SGold%20Rush%20Gulch,SAsterocrat,SA%20long%20time%20ago%2c%20gold%20was%20struck%20in%20this%20here%20ravine%21%20Ever%20since%2c%20the%20place%20has%20been%20a%20hot%20spot%20for%20all%20manner%20of%20miners%20and%20prospectors%20looking%20to%20get%20rich%20quick%21%20The%20ravine%20coined%20itself%20the%20name%20Gold%20Rush%20Gulch.%0a%0aIn%201889%2c%20Shellpass%20Town%20was%20founded%20within%20the%20gulch%20and%20is%20home%20to%20the%20Shellpass%20Mineshaft.%20Once%20a%20quaint%2c%20humble%20little%20town%2c%20it%20recently%20gained%20a%20second%20wind%20after%20Ax%27Em-corp%20contracted%20a%20lucrative%20new%20mining%20operation.%20To%20this%20day%2c%20the%20Shellpass%20Mineshaft%20holds%20treasures%20yet%20to%20be%20discovered%2c%20and%20there%27s%20more%20gold%20to%20be%20found%20than%20ever%20before%21,Sgrgthumb,IE,IU,IF,IlB][[[Sf80e7835-019f-49f3-ac14-a3bf75e44c73,B1,SCloud%20Path%20Above%20the%20Town,SHop%20your%20way%20to%20a%20Shine%20beaming%20high%20above%20the%20desert.%20The%20path%20starts%20on%20the%20west%20side%20of%20Shellpass%20Town.,IB,C[FB,FB,FA,FB],B1,IA,Sspawn,IB][Sc332f67a-65d6-4813-a083-de14810b236d,B1,SMining%20for%20Shine%20Shards,SLook%20for%20the%20five%20Shine%20Shards%20scattered%20around%20the%20vast%20chamber%20at%20the%20heart%20of%20the%20mines.,IC,C[FB,FB,FA,FB],B1,IA,Sspawn,IC][Saba437d6-994e-4259-aebf-5ad4a864e4d1,B1,SAtop%20the%20Mesa,SClimb%20the%20imposing%20mountain%20overlooking%20the%20east%20side%20of%20town.%20This%20may%20require%20a%20boost%20and%20some%20jump%20tricks...,ID,C[FB,FB,FA,FB],B1,IA,Sspawn,ID][S54cbe8c7-9965-4b4e-a3dc-c28c6490538e,B1,SSecret%20of%20the%20Mines,SA%20Shine%20is%20hidden%20underground%2c%20among%20the%20caves%20and%20the%20mineshafts.%20You%20don%27t%20need%20to%20use%20a%20pipe%20to%20find%20it.,IG,C[FB,FB,FA,FB],B1,IA,Sspawn,IG][S82695d86-642e-454b-8833-c68a62541c02,B1,SShellpass%20Metal%20Rally,SGrab%20the%20first%20Power%20Gear%20in%20the%20western%20part%20of%20the%20mines%20and%20hop%20from%20gear%20to%20gear%20to%20the%20Shine%20Sprite.%20Follow%20the%20metal%20arrows%21,IE,C[FB,FB,FA,FB],B1,IA,Sspawn,IE][S1e341760-9f8c-4b30-8550-7c5eec36d5db,B1,SShimmering%20Mine%20Depths,SHead%20to%20the%20pipe%20at%20the%20very%20bottom%20of%20the%20mines%20below%20Shellpass%20Town.%20Watch%20out%20for%20the%20vicious%20fauna%20growing%20along%20the%20way%21,IA,C[FB,FB,FA,FB],B1,IA,Sspawn,IA][Sd028509c-465c-4a84-a71e-d02781aae1bb,B1,SGuide%20the%20Rolling%20Steelies%20,SFind%20a%20way%20into%20the%20well%2c%20where%20a%20hidden%20pipe%20awaits%20you%2c%20then%20complete%20the%20secret%20challenge%20on%20the%20other%20side%21,IF,C[FB,FB,FA,FB],B1,IA,Sspawn,IF]][[S261b8ea6-1de8-46bc-9765-9c347f387392,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][S365538ad-41a6-43ce-8c1e-0857c6a12ae1,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][Sc5300238-d210-4dbd-a0ff-e833eb857d68,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][S3bc7537a-0302-4b7f-b7d0-e09053d33237,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]][S81231468-8f63-41b9-bbe7-0b6518001bfe,SThis%20Star%20Coin%20doesn%27t%20have%20a%20hint.,C[FB,FB,FA,FB]]][IA][A[Sf80e7835-019f-49f3-ac14-a3bf75e44c73,Sc332f67a-65d6-4813-a083-de14810b236d,Saba437d6-994e-4259-aebf-5ad4a864e4d1,S54cbe8c7-9965-4b4e-a3dc-c28c6490538e,S82695d86-642e-454b-8833-c68a62541c02,S1e341760-9f8c-4b30-8550-7c5eec36d5db,Sd028509c-465c-4a84-a71e-d02781aae1bb],A[IB,IB,IB,IB,IB,IB,IB]][B0][]]}[[{R[FA,FA,FWC,FeB],S,IE,IU,IF,FA,FH.2C,FA,Iw,S,IF,IA,B0,SCustom%20Song,SUnknown%20Author,B0,F~B,B1}[[{FA,V[FA,FA],B0,C[FA.KO5F,FA.KO5F,FA.KO5F,FB],IA,B0,aS[],FB,SVery%20Back,B0,Se0600240-4bcb-4691-b2f6-1af97e11c663,B1,IA,I~B,I~B}[T[YAQAAAB8AeJxjYBgFo2DQAX4mBn5mEhRLMoAQkVrkkBgAJUYAtQEAAQBDAHicY2AgDOQwGATVS4LREFWPDKQZGCEIlwJJVDTg6rlQEUFAqnoM7UzIiKB6ZRyIVPW4NGIqALoKSMrCEBobAOpWCeoIAAEAQgB4nGNgwAKUsSE8QJmRNPVYrcBnOCnmY1VM0D0QIMHACEfEqOdiYISjkWk-1qAWYmCCIDT1WBUjq8dEtFYPANA3DbgCA