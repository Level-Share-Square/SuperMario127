script = ExtResource( 1 )
code = "[{[SCosmic%20Castle,SSilvererCoin,SEvery%20so%20often%2c%20chunks%20of%20cosmic%20matter%20will%20accumulate%2c%20populating%20the%20area%20around%20certain%20points%20of%20interest.%20These%20chunks%20are%20commonly%20referred%20to%20as%20%22Star%20Bits%22.%20Rumors%20say%2c%20if%20you%20bring%20enough%20of%20them%20together%2c%20their%20stellar%20energy%20may%20mix%20together%20to%20create%20a%20Shine%20Sprite.%0a%0aLuckily%2c%20you%27ve%20found%20signs%20of%20Star%20Bits%20residing%20within%20an%20old%20fortress%20floating%20in%20space.%20Due%20to%20strong%20gravitational%20forces%20the%20castle%20is%20already%20collapsing...%20you%27ll%20need%20to%20move%20fast%20to%20make%20it%20out%20alive%21,Sthumbnail,ID,IA,IA,IlB][[[S930b30b4-55dc-47a4-a99e-4ecee6713306,B1,SCosmic%20Purple%20Labyrinth,S,IA,C[FB,FB,FA,FB],B1,IA,Sspawn]][][IA][A[S930b30b4-55dc-47a4-a99e-4ecee6713306],A[IB]][B0][]]}[[{R[FA,FA,FxC,FJB],S,ID,IA,IA,FA,FH.2C,F4B,IE,S,IA,I9B,B0,SCustom%20Song,SUnknown%20Author,B0,F~B,B1}[[{FA,V[FA,FA],B0,C[FA.KO5F,FA.KO5F,FA.KO5F,FB],IA,B0,aS[],FB,SVery%20Back,B0,S6ea163bb-4098-463e-b506-86109ccbb860,B1,IA,I~B,I~B}[T[YBwAAAC0AeJxjYBhgoMDAioxG1ZOhHk0NHvV4VGJqIUYxGepxIWMGRiCinXqsCACpOxLiCAAAACUAeJxjYKAtUGBgHUVUQSSFJ0nhT2p8kaSe1PRAU_WY6RMA21wbdwkAAABAAHicY2CgLVBgYB3SCO4LIr1GasiQGpg0VU9noMrECGUwMxKjGFk9Hi2qDIwgxMTIzcAGEQEyQFrA4miKASuGDPsKAAAAKQB4nGNgoC1QYGDFhbCqF2RgJ0k9qeaPqqeuejxaBko9Li1YVQIAVYERcQMAAAAoAHicY2AYBYSBAgMrkYhG6o0ZGIGIduopdD8dQh6_q0iNKbh6AOYTD_4EAAAAIgB4nGNgGAX4gAID60AhYwZGIKKdeqogWgc-Tc0HAgCnNQ5CBQAAACIAeJxjYBgF-IACAys9kTEDIxDRTj3V0RAKSTgXWRwAyTMVkwYAAAAqAHicY2AYBfiAAgMrHA179ciKcalHU0OJeqog_FYYMzCiMeBciAgAWbwMqwIAAAAWAHicY2AYBaNgaAMFBlY4IlU9ACccASkCAAEAHgB4nGNgIAwUGFjhiAjlo-qpph5Z5ah6WqgHAPK6C5EDAAEALgB4nFNgYFUgAjHAADGKkdUbMzBiVYAmTrZ6Ut1Da_Ujzb-4FJDq_oHyLwDNAh6nBAABABkAeJxjYCABKDCwkqKc5upHwSigEAAAJ54AcAUAAQA3AHicU2BgVQAjYwZGIFKAcSEiaAw6IAYGBqyCWMGoelzqweKkqscZ_qTGF27EQGPzSfYvABqnGcgGAAEALQB4nFNgYFVAQsYMjGgMOBdNhNaIAQcYVQ9GDGCERRepoUrPOKU_IuhfACh