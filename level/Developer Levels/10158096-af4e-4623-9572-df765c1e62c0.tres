code = "[{[SMortal%20Magma%20Massif,SLinktober,STwo%20opposing%20factions%20rule%20this%20turf.%20On%20the%20west%20side%2c%20the%20Dark%20Star%20Clan%20reigns%20supreme.%20Use%20the%20durability%20of%20their%20Power%20Gear%20to%20traverse%20fire%20and%20lava%20with%20ease%21%20%0aOn%20the%20east%20side%2c%20Bowser%27s%20Army%20remains%20king.%20Their%20on%2foff%20blocks%20give%20them%20control%20over%20the%20terrain%2c%20thus%20they%20hold%20the%20strategical%20advantage.%20Surely%20they%20won%27t%20notice%20if%20one%20of%20their%20shine%20sprites%20goes%20missing%2c%20right%3f,Smmmthumb,IF,IT,IA,IkB][[[Sd679f6e6-ccbc-477c-9ddf-a29408f128eb,B1,SSky-High%20Shards,SAmong%20the%20towers%20in%20the%20north%20eastern%20skies%2c%20Shine%20Shards%20are%20scattered.,IC,C[FB,FB,FA,FB],B1,IA,Sspawn][Sa370838a-9b8a-423b-9bf5-71bdaed6ec76,B1,SThe%20Flooded%20Secret,S,IH,C[FB,FA.LC,FA,FB],B1,IA,Sspawn][S22bbf060-4f38-4e5e-ba38-672b7cb0bbd4,B1,SRed-hot%20Coins,SInside%20the%20middle%20of%20the%20Mortal%20Magma%20Land%20Overworld%20there%20are%208%20Red%20Coins%20scattered.,IG,C[FB,FB,FA,FB],B0,IA,Sspawn][S5481767a-3b69-43c4-84ec-3348eae03e3b,B1,SCharcoal%20Castle,SA%20hidden%20obstacle%20course%20at%20Charcoal%20Castle%20to%20the%20west.%20Reveal%20it%20and%20take%20its%20prize%21,ID,C[FB,FB,FA,FB],B1,IA,Sspawn][Sad688ec1-0f3a-41c5-ad51-1211254ac1b5,B1,SThe%20One%20Shot%20Challenge,STravel%20from%20the%20Western%20Volcano%20to%20the%20Eastern%20Castle%20in%20one%20shot%2c%20no%20F.L.U.D.D.%20and%20no%20checkpoints%21,IG,C[FB,FB,FA,FB],B1,IA,Sspawn][S4362b104-7f1f-43f5-a716-524aca3fca77,B1,SThe%20Lava%20Spire,S4%20Shine%20Shards%20are%20stored%20inside%20of%20a%20tower%20of%20lava%20inside%20the%20eastern%20castle.,IA,C[FB,FB,FA,FB],B1,IA,Sspawn][S9ea47c5f-b4a1-475f-b149-9222b5017bc4,B1,SMagma%20Cavern%20Rush,SLava%20fills%20the%20caverns%20beneath%20the%20volcano%21%20Run%20through%20it%20quickly%21,IE,C[FB,FB,FA,FB],B1,IA,Sspawn][Se55a0045-619f-476e-9433-4df47c371941,B1,SSecret