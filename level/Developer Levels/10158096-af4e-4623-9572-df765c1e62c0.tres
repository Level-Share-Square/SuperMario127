code = "[{[SMortal%20Magma%20Massif,SLinktober,STwo%20opposing%20factions%20rule%20this%20turf.%20On%20the%20west%20side%2c%20the%20Dark%20Star%20Clan%20reigns%20supreme.%20Use%20the%20durability%20of%20their%20Power%20Gear%20to%20traverse%20fire%20and%20lava%20with%20ease%21%20%0aOn%20the%20east%20side%2c%20Bowser%27s%20Army%20remains%20king.%20Their%20on%2foff%20blocks%20give%20them%20control%20over%20the%20terrain%2c%20thus%20they%20hold%20the%20strategical%20advantage.%20Surely%20they%20won%27t%20notice%20if%20one%20of%20their%20shine%20sprites%20goes%20missing%2c%20right%3f,S,IF,IT,IA,IlB][[[S9012a15a-daee-4c98-8b2f-2c920441322d,B1,SSky-High%20Shards,SAmong%20the%20towers%20in%20the%20north%20eastern%20skies%2c%20Shine%20Shards%20are%20scattered.,IC,C[FB,FB,FA,FB],B1,IA,Sspawn,IA][Sab71a5aa-f5a4-44f5-b6c6-35cbe1be7de6,B1,SThe%20Flooded%20Massif,SMake%20your%20way%20west%20across%20the%20entirety%20of%20flooded%20Mortal%20Magma%20Massif%21,IH,C[FB,FA.LC,FA,FB],B1,IA,Slavashine,IB][Scf86f16d-0ef3-4097-bc1a-3c2959ea62a3,B1,SRed-hot%20Coins,SInside%20the%20middle%20of%20the%20Mortal%20Magma%20Land%20Overworld%20there%20are%208%20Red%20Coins%20scattered.,IG,C[FB,FB,FA,FB],B0,IA,Sspawn,IC][Sb005e176-cf35-44a8-ac6b-e9683c4623a9,B1,SCharcoal%20Castle,SA%20hidden%20obstacle%20course%20at%20Charcoal%20Castle%20to%20the%20west.%20Reveal%20it%20and%20take%20its%20prize%21,ID,C[FB,FB,FA,FB],B1,IA,Sspawn,ID][S768ef442-d650-4928-9a4a-d891df1fde59,B1,SThe%20One%20Shot%20Challenge,STravel%20from%20the%20Western%20Volcano%20to%20the%20Eastern%20Castle%20in%20one%20shot%2c%20no%20F.L.U.D.D.%20and%20no%20checkpoints%21,IG,C[FB,FB,FA,FB],B1,IA,Sspawn,IE][Sedb4b646-8300-41b8-94e9-be810a3068d9,B1,SThe%20Lava%20Spire,S4%20Shine%20Shards%20are%20stored%20inside%20of%20a%20tower%20of%20lava%20inside%20the%20eastern%20castle.,IA,C[FB,FB,FA,FB],B1,IA,Sspawn,IF][S1f77bcdb-e57b-4faf-af39-30ee14f185d1,B1,SMagma%20Cavern%20Rush,SLava%20fills%20the%20caverns%20beneath%20the%20volcano%21%20Run%