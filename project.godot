2d_physics/layer_17="crushers"

[logging]

file_logging/enable_file_logging=true

[memory]

limits/multithreaded_server/rid_pool_prealloc=120
limits/message_queue/max_size_kb=2048

[mono]

project/assembly_name="Super Mario 127"

[network]

limits/debugger_stdout/max_chars_per_second=100000
limits/debugger_stdout/max_messages_per_frame=100

[physics]

2d/use_bvh=false

[rendering]

quality/driver/fallback_to_gles2=true
quality/intended_usage/framebuffer_allocation=0
quality/intended_usage/framebuffer_allocation.mobile=0
threads/thread_model=2
vram_compression/import_bptc=true
vram_compression/import_etc=true
quality/filters/anisotropic_filter_level=1
batching/parameters/item_reordering_lookahead=0
batching/precision/uv_contract=true
gles3/shaders/shader_compilation_mode=2
2d/options/culling_mode=0
limits/buffers/canvas_polygon_buffer_size_kb=1024
limits/buffers/canvas_polygon_index_buffer_size_kb=1024
limits/rendering/max_renderable_elements=131072
environment/default_clear_color=Color( 0.301961, 0.301961, 0.301961, 1 )
quality/2d/use_pixel_snap=false
