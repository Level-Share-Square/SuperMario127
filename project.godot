[application]

config/name="Super Mario 127"
run/main_scene="res://scenes/menu/launcher/launcher.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="dev"
boot_splash/image="res://assets/misc/startup_new.png"
boot_splash/bg_color=Color( 0.431373, 0.0352941, 0.34902, 1 )
config/icon="res://assets/misc/icon.png"
config/windows_native_icon="res://assets/misc/icon.ico"

[autoload]

LocalSettings="*res://singletons/local_settings.gd"
Singleton="*res://singletons/main_singleton.gd"
SettingsLoader="*res://singletons/settings_loader.tscn"
Discord="*res://addons/discord_game_sdk/discord.gd"
LastInputDevice="*res://singletons/last_input_device.gd"
LSSPing="*res://singletons/lss_ping.tscn"
CurrentLevelData="*res://scenes/shared/current_level_data.tscn"
SceneTransitions="*res://scenes/actors/scene_transitions/SceneTransitions.tscn"
ModLoader="*res://singletons/mod_loader.gd"
EditorState="*res://singletons/editor_state.gd"
Hotkeys="*res://singletons/hotkeys.gd"
AssetHandler="*res://singletons/asset_handler.tscn"
Singleton2="*res://singleton2.gd"

[debug]

settings/fps/force_fps=60
gdscript/warnings/integer_division=false
shapes/collision/shape_color=Color( 0, 0.6, 0.701961, 0.419608 )

[discord_presence]

first_button/label="like and subscribe"
first_button/url="https://charpurrr.itch.io/super-mario-127"
second_button/label=""
second_button/url=""

[display]

window/size/width=768
window/size/height=432
window/size/resizable=false
window/size/test_width=1536
window/size/test_height=864
mouse_cursor/custom_image="res://assets/misc/cursor.png"
mouse_cursor/tooltip_position_offset=Vector2( 0, 0 )
window/stretch/mode="2d"
window/stretch/aspect="keep"
window/options/ninepatch_mode=0

[editor_plugins]

enabled=PoolStringArray( "res://addons/discord_game_sdk/plugin.cfg" )

[global]

physics=false
change=false
audio=false
transforms=false
fps=true
game_version="0.10.0"
level_code_version=100
old_level_code_version="0.5.5"
"Game Version"="0.10.0"

[importer_defaults]

texture={
"flags/filter": false
}

[input]

ui_accept={
"deadzone": 0.5,
"events": [  ]
}
ui_select={
"deadzone": 0.5,
"events": [  ]
}
ui_cancel={
"deadzone": 0.5,
"events": [  ]
}
ui_focus_next={
"deadzone": 0.5,
"events": [  ]
}
ui_focus_prev={
"deadzone": 0.5,
"events": [  ]
}
